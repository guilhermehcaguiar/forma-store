{
  "name": "forma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test",
    "preview": "vite preview",
    "api": "npm run dev --prefix server",
    "db:local": "node server/src/scripts/local-db.js",
    "api:setup": "npm run db:local && npm run api:migrate && npm run api:seed",
    "api:migrate": "npm run migrate --prefix server",
    "api:seed": "npm run seed --prefix server",
    "api:admin": "node server/src/scripts/criar-admin.js",
    "api:melhor-envio:autorizar": "npm run melhor-envio:autorizar --prefix server",
    "api:admin:demo": "node server/src/scripts/demo-admin.js",
    "test:db": "node scripts/check-db-tests.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
