{
  "name": "forma-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API local do FORMA (Express + PostgreSQL) para uso acadêmico",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrations/run.js up",
    "migrate:status": "node src/db/migrations/run.js status",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.13.1"
  }
}
