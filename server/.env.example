# SERVIDOR — valores exclusivamente fictícios. Nunca copie credenciais reais para Git.
# Opção recomendada: npm run api:setup gera DATABASE_URL e senha local aleatória.
NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://forma:SENHA_LOCAL_FICTICIA_TROQUE@127.0.0.1:55434/forma
CORS_ORIGIN=http://localhost:5173

# Autenticação: sessões opacas aleatórias de 32 bytes, hash SHA-256 no banco;
# senha do usuário em scrypt. Não existe JWT_SECRET/SESSION_SECRET neste código.
SESSION_TTL_DAYS=7

# Mercado Pago: credenciais DE TESTE da mesma aplicação. Marcadores não habilitam SDK.
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_TEST_ACCESS_TOKEN=TEST-ACCESS-TOKEN-FICTICIO-TROQUE
MERCADOPAGO_PUBLIC_KEY=TEST-PUBLIC-KEY-FICTICIA-TROQUE
MERCADOPAGO_WEBHOOK_SECRET=WEBHOOK-FICTICIO-TROQUE
# Cartão salvo exige callback e segredo válidos antes de iniciar a tentativa (503 se ausentes).
# Callback: endereço HTTPS público do túnel; IP privado/reservado/local não é aceito.
# Este domínio reservado nunca é um túnel real.
MERCADOPAGO_PUBLIC_URL=https://forma-tunel.example.invalid
MERCADOPAGO_FRONTEND_URL=http://localhost:5173

# Melhor Envio: o código fixa https://sandbox.melhorenvio.com.br.
# OAuth interativo: api:melhor-envio:autorizar. Cache privado em server/.local/.
MELHOR_ENVIO_CLIENT_ID=CLIENT-ID-FICTICIO-TROQUE
MELHOR_ENVIO_CLIENT_SECRET=CLIENT-SECRET-FICTICIO-TROQUE
MELHOR_ENVIO_REDIRECT_URI=http://localhost:3333/api/health
MELHOR_ENVIO_ORIGIN_CEP=50000000
MELHOR_ENVIO_USER_AGENT=FORMA (suporte@example.invalid)
# Alternativa ao cache OAuth: ambos opcionais; valores fictícios não são usados.
MELHOR_ENVIO_ACCESS_TOKEN=ACCESS-TOKEN-FICTICIO-TROQUE
MELHOR_ENVIO_REFRESH_TOKEN=REFRESH-TOKEN-FICTICIO-TROQUE

# E-mail: mock gera apenas prévias locais. Não representa entrega.
FORMA_EMAIL_MODE=mock
FORMA_EMAIL_FROM=no-reply@forma.local
FORMA_EMAIL_MAX_ATTEMPTS=5
# Para captura Mailpit local: smtp, 127.0.0.1:1025, none, USER/PASS vazios.
FORMA_SMTP_HOST=127.0.0.1
FORMA_SMTP_PORT=1025
FORMA_SMTP_SECURE=none
FORMA_SMTP_USER=USUARIO_SMTP_FICTICIO_TROQUE
FORMA_SMTP_PASS=SENHA_SMTP_FICTICIA_TROQUE
# SMTP externo: host do provedor, starttls:587 ou ssl:465, usuário e senha de app.
# Nunca transporte SMTP externo em plaintext. Entrega externa não homologada.
