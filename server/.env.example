# FORMA — API local.
# Copie este arquivo para server/.env antes de executar a API.
# Contém somente valores de desenvolvimento local; nunca coloque segredos reais aqui.

NODE_ENV=development

# Porta onde a API escuta
PORT=3333

# PostgreSQL local (usuário/banco criados no passo de instalação do README)
DATABASE_URL=postgresql://forma:forma@localhost:5432/forma

# Origem do front-end (Vite) aceita pelo CORS
CORS_ORIGIN=http://localhost:5173

# Validade da sessão, em dias
SESSION_TTL_DAYS=7

# Melhor Envio: sandbox por padrão. Nunca coloque essas credenciais no frontend.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=http://localhost:3333/api/health
MELHOR_ENVIO_ORIGIN_CEP=
MELHOR_ENVIO_USER_AGENT=FORMA (suporte@forma.local)

# Mercado Pago: apenas credenciais TESTE e Checkout Pro hospedado.
# Configure um túnel HTTPS temporário para callbacks em
# https://localhost.run/docs ou com `ngrok http 3333` e informe a URL abaixo.
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PUBLIC_URL=
MERCADOPAGO_FRONTEND_URL=http://localhost:5173

# E-mail transacional de confirmação de compra (RF18).
# FORMA_EMAIL_MODE:
#   mock — modo EXPLÍCITO de desenvolvimento/teste (padrão quando ausente):
#          nenhuma entrega acontece; as mensagens ficam como prévias locais em
#          email_outbox (mock_message). Nunca apresente essas prévias como envio.
#   smtp — entrega transacional real por SMTP (Mailpit local ou provedor).
# Sem esta variável o padrão é mock e a API registra o aviso na inicialização.
FORMA_EMAIL_MODE=mock

# SMTP — usado somente com FORMA_EMAIL_MODE=smtp.
# Mailpit local (desenvolvimento): host 127.0.0.1, porta 1025, secure none,
# sem usuário/senha; acompanhe as mensagens em http://127.0.0.1:8025.
# Provedores externos: use secure starttls (587) ou ssl (465) e credenciais
# de aplicação — credenciais em plaintext só são aceitas em 127.0.0.1/localhost.
# Entrega externa ainda não homologada neste projeto.
FORMA_SMTP_HOST=
FORMA_SMTP_PORT=1025
FORMA_SMTP_SECURE=none
FORMA_SMTP_USER=
FORMA_SMTP_PASS=

# Remetente das mensagens transacionais e limite de tentativas por e-mail
# (após esgotar, a linha permanece 'failed' com last_error; reenvio manual).
FORMA_EMAIL_FROM=no-reply@forma.local
FORMA_EMAIL_MAX_ATTEMPTS=5
